# =============================================================================
# HRMS Backend — Environment Variables Template
# =============================================================================
# Copy this file to `.env` and fill in your values.
# NEVER commit the actual `.env` file to version control.
#
# Generate a secret key:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# =============================================================================

# ---------------------------------------------------------------------------
# CORE DJANGO
# ---------------------------------------------------------------------------

# REQUIRED in production. Must be a long, random, unique string.
DJANGO_SECRET_KEY=your-very-long-random-secret-key-goes-here

# Set to False in production
DEBUG=True

# Comma-separated list of allowed host headers
ALLOWED_HOSTS=127.0.0.1,localhost


# ---------------------------------------------------------------------------
# DATABASE — PostgreSQL (recommended for production)
# ---------------------------------------------------------------------------
# Option A: Single connection URL (preferred)
# DATABASE_URL=postgres://hrms_user:strongpassword@localhost:5432/hrms_db

# Option B: Individual variables
DB_ENGINE=django.db.backends.postgresql
DB_NAME=hrms_db
DB_USER=hrms_user
DB_PASSWORD=strongpassword
DB_HOST=localhost
DB_PORT=5432

# For local development with SQLite, leave DATABASE_URL unset and:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3


# ---------------------------------------------------------------------------
# CORS — Frontend origin(s) allowed to talk to the API
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


# ---------------------------------------------------------------------------
# CHAT / REAL-TIME
# ---------------------------------------------------------------------------
# Backend for real-time chat: "memory" (single process dev) or "redis" (production)
CHAT_REALTIME_BACKEND=memory

# Redis URL — required when CHAT_REALTIME_BACKEND=redis
# CHAT_REDIS_URL=redis://localhost:6379/0

CHAT_REALTIME_CHANNEL_PREFIX=hrms-chat


# ---------------------------------------------------------------------------
# CELERY — Async task queue (payroll batch, PDF generation)
# ---------------------------------------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2


# ---------------------------------------------------------------------------
# COMPANY SETTINGS (used in payslip PDF headers)
# ---------------------------------------------------------------------------
COMPANY_NAME=Palepu Pharma
COMPANY_ADDRESS=Your Company Address Here
COMPANY_PAN=AAAAA0000A
COMPANY_TAN=AAAA00000A
COMPANY_PF_NUMBER=KA/BNG/0000000/000
COMPANY_ESI_NUMBER=000000000000000
